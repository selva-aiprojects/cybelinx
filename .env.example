RESEND_TO_COMMERCE=
RESEND_TO_OPERATIONS=
RESEND_TO_AI=

# Public booking page used by the Contact page.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/cognivectra-demo/15min